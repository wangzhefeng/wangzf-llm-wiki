E_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"},{"startIndex":2800,"length":4,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4282296063},{"key":"USER_INTERFACE_THEME_LIGHT","value":4278607828}]}},"fontFamilyName":"Roboto"},{"startIndex":2804,"length":46,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"},{"startIndex":2850,"length":4,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4282296063},{"key":"USER_INTERFACE_THEME_LIGHT","value":4278607828}]}},"fontFamilyName":"Roboto"},{"startIndex":2854,"length":24,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":2587,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2587,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2591,"length":27,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2618,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2622,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2674,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2678,"length":66,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2744,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2748,"length":52,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2800,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2804,"length":46,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2850,"length":4,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":2854,"length":24,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963440,"raisedBackground":4294963440,"additiveBackground":566838597,"textPrimary":4281731594,"textSecondary":4285413946,"invertedBackground":4287568153,"overlayBackground":3426093578},"darkThemeColorPalette":{"baseBackground":4280025602,"raisedBackground":4281731594,"additiveBackground":734610757,"textPrimary":4294631648,"textSecondary":4292717740,"invertedBackground":4293098620,"overlayBackground":3426093578},"colorSampledDescriptionBodyText":{"content":"In this video, I have tried breaking down the concept of Self Attention which is vital to how LLMs run visually and as simply as possible \n\nHere is a summary of what is going on as quickly as possible\n\nLet us first build an intuition behind the idea.\nSentence {s}: “Pramod loves pizza”\n\nQuestion:\n\nWho loves pizza?\nYou can come up with as many Questions and queries for the sentence as you want. Now for each query, you will have one specific piece of information the key that will give you the desired answer the value\n\nYou can come up with as many questions {the queries} for the sentence as you want. Now for each query, you will have one specific piece of information {the key} that will give you the desired answer {the value}\n\nQuery:\n\nQ - Who loves pizza?\nK - pizza, Pramod, loves {it will actually have all the words with different degrees of importance}\nV - pizza {The value is not directly the answer, but a representation as a matrix of something similar to the answer}\n\nThis is an oversimplification, really, but it helps understand that the queries, keys, and values can all be created only using the sentences.\n\nLet us first understand how Self-attention is applied and subsequently understand why it is even done. Also, for the rest of the explanation, treat Q,K, and V purely as matrices and nothing else.\n\nFirst, The word “Delicious Pizza” is converted into embeddings (x1,x2). Then it is multiplied with the weights W_Q, W_K, W_V to produce Q,K,V vectors.\n\nThese weights W_Q, W_K, W_V are trained alongside with the transformer. the vector Q,K,V are smaller than the size of x1,x2. Namely, x1,x2 are vectors of size 512. Whereas Q,K,V are of size 64. This is an architectural choice to make the computation smaller and faster.\n\nNow using these Q,K,V vectors the attention score is calculated.\n\nCalculating the attention score for the first word “Delicious” we take the query (q1) and key (k1) of the word and take a dot product of them. (Dot products are great to find similarities between things).\n\nThen we divide that by Square root of the dimension of key vector. This is done to stabilize training.\n\nThe same process is done with the query of word one (q1) and all the keys of the different words in this case k1 \u0026 k2.\n\nFinally using all the values, we take a softmax of each out.\n\nThen these are multiplied by the value of each word (v1,v2). Intuitvely to get the importance of each word with respect to the selected words. Less important words are drowned out by lets say multipling with 0.001.\nAnd finally, everything is summed up to get the Z vector\n\nTimestamp\n\n0:30 Working of Self Attention\n2:30 Calculating the Attention score of the first word \n3:52 Understanding what happens to words during Attention calculation\n4:20 Calculating the Attention score of the second word\n5:00 Calculating the Attention score of A Matrix \n6:55 Why does Attention work","commandRuns":[{"startIndex":2587,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAgiEwiN2Izw-POTAxWBRvIAHUKTBpLKAQSRpP3t","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=vW-uktXeq2E\u0026t=30s","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"vW-uktXeq2E","continuePlayback":true,"startTimeSeconds":30,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr5---sn-n4v7snl7.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026ofpcc=1\u0026msp=1\u0026odepv=1\u0026id=bd6fae92d5deab61\u0026ip=2602%3Afeda%3Add0%3Acbaf%3Aa130%3Adf9%3Aa02d%3A14c5\u0026osts=30\u0026initcwndbps=3410000\u0026mt=1776396312\u0026oweuc=\u0026pxtags=Cg4KAnR4Egg1MTc3NDM0OQ\u0026rxtags=Cg4KAnR4Egg1MTc3NDM0OQ%2CCg4KAnR4Egg1MTc3NDM1Mg"}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"30秒钟"}}},{"startIndex":2618,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAgiEwiN2Izw-POTAxWBRvIAHUKTBpLKAQSRpP3t","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=vW-uktXeq2E\u0026t=150s","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"vW-uktXeq2E","continuePlayback":true,"startTimeSeconds":150,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr5---sn-n4v7snl7.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026ofpcc=1\u0026msp=1\u0026odepv=1\u0026id=bd6fae92d5deab61\u0026ip=2602%3Afeda%3Add0%3Acbaf%3Aa130%3Adf9%3Aa02d%3A14c5\u0026osts=150\u0026initcwndbps=3410000\u0026mt=1776396312\u0026oweuc=\u0026pxtags=Cg4KAnR4Egg1MTc3NDM0OQ\u0026rxtags=Cg4KAnR4Egg1MTc3NDM0OQ%2CCg4KAnR4Egg1MTc3NDM1Mg"}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"2分钟30秒钟"}}},{"startIndex":2674,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBwQ040EGAgiEwiN2Izw-POTAxWBRvIAHUKTBpLKAQSRpP3t","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=v