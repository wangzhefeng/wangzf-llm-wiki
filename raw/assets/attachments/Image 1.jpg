y":4294631648,"textSecondary":4292717740,"invertedBackground":4293098620,"overlayBackground":3426093578},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtpR3hUUmQ5NjdJVSDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"2,875"},"label":{"simpleText":"观看次数"},"accessibilityText":"2,875次观看","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963440,"raisedBackground":4294963440,"additiveBackground":566838597,"textPrimary":4281731594,"textSecondary":4285413946,"invertedBackground":4287568153,"overlayBackground":3426093578},"darkThemeColorPalette":{"baseBackground":4280025602,"raisedBackground":4281731594,"additiveBackground":734610757,"textPrimary":4294631648,"textSecondary":4292717740,"invertedBackground":4293098620,"overlayBackground":3426093578},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2025年"},"label":{"simpleText":"1月25日"},"accessibilityText":"2025年1月25日","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963440,"raisedBackground":4294963440,"additiveBackground":566838597,"textPrimary":4281731594,"textSecondary":4285413946,"invertedBackground":4287568153,"overlayBackground":3426093578},"darkThemeColorPalette":{"baseBackground":4280025602,"raisedBackground":4281731594,"additiveBackground":734610757,"textPrimary":4294631648,"textSecondary":4292717740,"invertedBackground":4293098620,"overlayBackground":3426093578},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBgQ040EGAgiEwid49rw-POTAxXQpSsGHZWhFADKAQRhZaKU","commandMetadata":{"webCommandMetadata":{"url":"/@goyal_pramod","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCkolNouNS-2GeJcxWPuOsFA","canonicalBaseUrl":"/@goyal_pramod"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/L3N9TgNvaXuGQbDYcQeeXBRF9kPmM6_AkEYSkV5lMXugZOfE0CasZpqlypGiyIQ1FdFQ93P9NJQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"展开"}},"simpleText":"...更多"},"showLessText":{"simpleText":"收起"},"attributedDescriptionBodyText":{"content":"In this video, I have tried to have  a comprehensive look at Positional Encoding, one of the fundamental requirements of transformer architectures. We start with understanding why PE is necessary through practical examples, explore how different encodings work, and dive deep into modern approaches like RoPE.\nIn this video, we cover:\n\nWhy transformers need positional encoding\nRequirements for creating a positional encoder\nInteger encoding and its limitations\nSinusoidal encoding from the original transformer paper\nRotary Position Encoding (RoPE) and its advantages\n\nInspiration has been heavily taken from the following blog:\nhttps://huggingface.co/blog/designing...\n\nTo have a deep dive at transformers, consider reading my blog on the topic:\nhttps://goyalpramod.github.io/blogs/T...\n\nChapters: \n\n0:00 Introduction\n0:30 Why we need positional Encoding\n3:00 Integer Encoding\n4:00 Sinusoidal Encoding\n6:10 Rotary Position Encoding\n7:10 RoPE Explained\n8:45 RoPE Summary\n\nFeel free to reach out to me from my various socials, I am more than happy to talk to people about stuff (not limited to AI/ML).","commandRuns":[{"startIndex":630,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAgiEwid49rw-POTAxXQpSsGHZWhFABIhdnr-93olLaIAcoBBGFlopQ=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbVlhNm9FQUo2eXBuYzU0WW5ORU1YN1ZkNjktQXxBQ3Jtc0ttdjNRZi1DMkFvTGltN28yOUhaMWFmMXhNUGFyZEJQZEdCYWxSU0sxR1lHWjBHRm5lSHVqMFlWcFFjSGVYdFRaUUJfY0JaNWlzTHk4Nll0UkdaZVpKZE1YT21tdlhCSm5NNTdKVWo1Y1Zhald3MW5n